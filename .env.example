# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================================

# SQLite (desarrollo rápido local):
# DATABASE_URL=sqlite:///teamcelular.db

# PostgreSQL (local):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/teamcelular

# PostgreSQL (Railway - se configura automáticamente en producción):
DATABASE_URL=postgresql://user:password@host:port/database

# ===========================================
# AUTENTICACIÓN JWT
# ===========================================
# Clave secreta para firmar tokens JWT (¡CAMBIAR EN PRODUCCIÓN!)
SECRET_KEY=tu-clave-secreta-muy-segura-cambiar-en-produccion

# Algoritmo de encriptación
ALGORITHM=HS256

# Tiempo de expiración del token en minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# CORS (Opcional)
# ===========================================
# Orígenes permitidos separados por coma. Por defecto permite todos (*).
# ALLOWED_ORIGINS=https://tudominio.com,https://app.tudominio.com

# ===========================================
# APP (Opcional)
# ===========================================
# Entorno: development | production
# ENV=development

# Nivel de logs: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# En producción, correr migraciones fuera del proceso web (ej: docker-entrypoint.py).
# RUN_MIGRATIONS_ON_STARTUP=0

# Si ALLOWED_ORIGINS="*", por defecto se deshabilitan credentials en CORS.
# CORS_ALLOW_CREDENTIALS=0
